<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/match_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF" android:textStyle="bold" />
    <TextView android:id="@+id/match_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#22C55E" />
    <TextView android:id="@+id/match_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#94A3B8" />
    <Button android:id="@+id/btn_goal" style="@style/Widget.Synq.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/match_goal_home" />
</LinearLayout>
